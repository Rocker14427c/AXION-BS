<?xml version="1.0" encoding="utf-8"?>
<!--
    The power-saving home screen, laid out the way a phone's own super power
    saving mode lays one out: a nearly black screen, one small row of controls at
    the top, a large centred clock, a 3x2 grid of apps, and the battery reading
    near the bottom.

    What is deliberately NOT here any more: the yellow "On - Super power saving"
    pill (state is obvious from the screen you are looking at), and any colour
    other than white and grey.

    The three controls are icon buttons rather than words: Exit on the left,
    Recents and Edit on the right. Every one of them is bound in
    SpsmHomeActivity - nothing in this file is decoration without a job.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:paddingTop="6dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageButton
            android:id="@+id/btn_exit"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/exit"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_power"
            android:tint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/btn_edit"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/edit"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_edit"
            android:tint="@color/text_secondary" />

        <!--
            A visible way into SPSM's own recents. The gesture alone is not
            enough: swiping up from the bottom edge belongs to Android's own
            navigation, which opens the launcher's recents before this activity
            is ever asked.
        -->
        <ImageButton
            android:id="@+id/btn_recents"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/recents_button"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_recents"
            android:tint="@color/text_secondary" />
    </FrameLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:letterSpacing="0.18"
        android:text="@string/super_power_saving"
        android:textAllCaps="true"
        android:textColor="@color/text_hint"
        android:textSize="10sp" />

    <!-- The large centred clock, kept exactly as it was: it is the one thing on
         this screen that reads at a glance from across a room. -->
    <TextClock
        android:id="@+id/clock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/white"
        android:textSize="76sp" />

    <TextClock
        android:id="@+id/date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:format12Hour="EEE, d MMM"
        android:format24Hour="EEE, d MMM"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <include layout="@layout/item_app_slot" android:id="@+id/slot0"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <include layout="@layout/item_app_slot" android:id="@+id/slot1"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <include layout="@layout/item_app_slot" android:id="@+id/slot2"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <include layout="@layout/item_app_slot" android:id="@+id/slot3"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <include layout="@layout/item_app_slot" android:id="@+id/slot4"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <include layout="@layout/item_app_slot" android:id="@+id/slot5"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.55"
        android:orientation="vertical" />

    <!-- The battery reading and its estimate, near the bottom, over a lot of
         empty black. The value and the wording are unchanged. -->
    <TextView
        android:id="@+id/battery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="100%"
        android:textColor="@color/white"
        android:textSize="40sp" />

    <TextView
        android:id="@+id/remaining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/home_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:text="@string/swipe_for_recents"
        android:textColor="@color/text_hint"
        android:textSize="10sp" />
</LinearLayout>
