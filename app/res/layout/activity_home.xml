<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:paddingTop="12dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btn_exit"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            android:contentDescription="@string/exit"
            android:padding="12dp"
            android:src="@drawable/ic_exit" />

        <!--
            A button, not only a gesture. Swiping up from the bottom edge of the
            screen belongs to Android's own navigation: the system takes that
            swipe before this app ever sees it, and opens the launcher's recents
            - the very thing this mode is trying to avoid. So the way in is a
            visible button, and the swipe and the long press still work for the
            swipes that do reach here.
        -->
        <TextView
            android:id="@+id/btn_recents"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/chip_mode"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="@string/recents_button"
            android:textColor="@color/accent"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/chip_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_chip"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="@string/active"
            android:textColor="@color/accent"
            android:textSize="11sp" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:text="@string/super_power_saving"
            android:textAllCaps="true"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="100%"
            android:textColor="@color/white"
            android:textSize="68sp" />

        <TextView
            android:id="@+id/remaining"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/accent"
            android:textSize="14sp" />

        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false"
            android:textColor="@color/text_secondary"
            android:textSize="28sp" />

        <TextClock
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:format12Hour="EEE, d MMM"
            android:format24Hour="EEE, d MMM"
            android:textColor="@color/text_hint"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <include layout="@layout/item_app_slot" android:id="@+id/slot0"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <include layout="@layout/item_app_slot" android:id="@+id/slot1"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <include layout="@layout/item_app_slot" android:id="@+id/slot2"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <include layout="@layout/item_app_slot" android:id="@+id/slot3"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <include layout="@layout/item_app_slot" android:id="@+id/slot4"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <include layout="@layout/item_app_slot" android:id="@+id/slot5"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/home_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="16dp"
        android:text="@string/swipe_for_recents"
        android:textColor="@color/text_hint"
        android:textSize="11sp" />
</LinearLayout>
