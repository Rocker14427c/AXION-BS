<?xml version="1.0" encoding="utf-8"?>
<!--
    The power-saving home screen, laid out the way a phone's own super power
    saving mode lays one out: a nearly black screen, one small row of controls at
    the top, a large centred clock, a 3x2 grid of apps, and the battery reading
    near the bottom.

    What is deliberately NOT here any more: the yellow "On - Super power saving"
    pill (state is obvious from the screen you are looking at), and any colour
    other than white and grey.

    Two controls, both icon buttons rather than words: Exit on the left, Edit on
    the right. Every one of them is bound in SpsmHomeActivity - nothing in this
    file is decoration without a job.

    The swipe up for recents is gone, by the owner's instruction: the phone is
    put into three-button navigation while the mode is on, so Recents is a
    button. nav_bar is what is shown if the phone refuses that switch, so this
    screen never ends up with no way to reach the recents list.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:paddingTop="6dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageButton
            android:id="@+id/btn_exit"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/exit"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_power"
            android:tint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/btn_edit"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/edit"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_edit"
            android:tint="@color/text_secondary" />

    </FrameLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:letterSpacing="0.18"
        android:text="@string/super_power_saving"
        android:textAllCaps="true"
        android:textColor="@color/text_hint"
        android:textSize="10sp" />

    <!-- The large centred clock, kept exactly as it was: it is the one thing on
         this screen that reads at a glance from across a room. -->
    <TextClock
        android:id="@+id/clock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/white"
        android:textSize="76sp" />

    <!-- Everything under the clock is pushed to the bottom of the screen: the
         six apps sit just above the time they have left, exactly as the owner
         asked, and the clock keeps the quiet black space above it. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <include layout="@layout/item_app_slot" android:id="@+id/slot0"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <include layout="@layout/item_app_slot" android:id="@+id/slot1"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <include layout="@layout/item_app_slot" android:id="@+id/slot2"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <include layout="@layout/item_app_slot" android:id="@+id/slot3"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <include layout="@layout/item_app_slot" android:id="@+id/slot4"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <include layout="@layout/item_app_slot" android:id="@+id/slot5"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- The time left, directly under the apps. The percentage that used to sit
         above it in 40sp is gone: "27% -> 2 h 10 m" says the same thing twice,
         and the estimate is the half of it that is worth reading. -->
    <TextView
        android:id="@+id/remaining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/home_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:text="@string/home_hint_hold"
        android:textColor="@color/text_hint"
        android:textSize="10sp" />

    <!-- Drawn only when the phone has no three buttons of its own. -->
    <include layout="@layout/nav_bar" android:id="@+id/nav_bar"
        android:layout_width="match_parent" android:layout_height="56dp" />
</LinearLayout>
