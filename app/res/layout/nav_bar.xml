<?xml version="1.0" encoding="utf-8"?>
<!--
    The three buttons, drawn by this mode itself.

    Why they exist at all: the owner's instruction was to stop using a swipe and
    use three-button navigation - "back will back, home button will take to the
    home of spsm and recent button will open recents". The knob
    (nav_buttons) asks the phone for its own three-button bar while the mode is
    on; this file is what is shown if the phone refuses, so that the buttons
    exist either way rather than the mode ending up with no way to reach its own
    recents.

    It is hidden whenever the phone IS showing its own three buttons - two sets
    of the same three glyphs stacked on top of each other is not a design.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nav_bar"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@color/black"
    android:orientation="horizontal"
    android:visibility="gone">

    <ImageButton
        android:id="@+id/nav_back"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/nav_back"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_back"
        android:tint="@color/text_secondary" />

    <ImageButton
        android:id="@+id/nav_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/nav_home"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_home"
        android:tint="@color/text_secondary" />

    <ImageButton
        android:id="@+id/nav_recents"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/nav_recents"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_recents"
        android:tint="@color/text_secondary" />
</LinearLayout>
