<?xml version="1.0" encoding="utf-8"?>
<!--
    Leaving the mode: a large dark sheet with rounded top corners that comes up
    from the bottom edge, one plain sentence, and two buttons - Cancel in grey,
    Exit in red. No title bar, no yellow, nothing to read that does not matter.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="26dp"
    android:paddingEnd="24dp"
    android:paddingBottom="26dp">

    <TextView
        android:id="@+id/dlg_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/exit_title"
        android:textColor="@color/white"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/dlg_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/exit_msg"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/dlg_cancel"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:background="@drawable/bg_pill_soft"
            android:minWidth="104dp"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <Button
            android:id="@+id/dlg_exit"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_pill_danger"
            android:minWidth="104dp"
            android:text="@string/confirm_exit"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
