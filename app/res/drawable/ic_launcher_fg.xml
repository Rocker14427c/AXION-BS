<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon's foreground: a tall battery in the mode's own green
     (#3DDC84, the app's "ok" colour), with the S on the fill in the
     background's dark. Everything is drawn well inside the adaptive icon's
     safe circle, so no mask the phone picks can clip it. Also serves as the
     themed (monochrome) icon layer on Android 13+. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The charge tip. -->
    <path
        android:fillColor="#FF3DDC84"
        android:pathData="M50,28.5 H58 A1.6,1.6 0 0 1 59.6,30.1 V34 H48.4 V30.1 A1.6,1.6 0 0 1 50,28.5 Z" />

    <!-- The battery body. -->
    <path
        android:fillColor="#FF3DDC84"
        android:pathData="M48.5,32.5 H59.5 A4.5,4.5 0 0 1 64,37 V71.5 A4.5,4.5 0 0 1 59.5,76 H48.5 A4.5,4.5 0 0 1 44,71.5 V37 A4.5,4.5 0 0 1 48.5,32.5 Z" />

    <!-- The S: top bar with its left leg, the middle bar, the right leg with
         the bottom bar - five rows, the way the tile's S is built. -->
    <path
        android:fillColor="#FF0C0E10"
        android:pathData="M48,42 H60 V47.2 H53.2 V52.4 H48 Z" />
    <path
        android:fillColor="#FF0C0E10"
        android:pathData="M48,52.4 H60 V57.6 H48 Z" />
    <path
        android:fillColor="#FF0C0E10"
        android:pathData="M54.8,57.6 H60 V62.8 H54.8 Z" />
    <path
        android:fillColor="#FF0C0E10"
        android:pathData="M48,62.8 H60 V68 H48 Z" />
</vector>
