<?xml version="1.0" encoding="utf-8"?>
<!-- The Quick Settings tile icon: a WIDE, FILLED battery with an S, drawn the
     way system tiles are drawn - one flat shape on a transparent 24dp canvas,
     which the system tints by state (white on the coloured circle while the
     mode is on, plain while off, exactly like Wi-Fi and Bluetooth). The S is
     part of the same path, so it is a true cut-out: it shows the tile's own
     colour through the filled battery, which is how it reads as white on the
     active tile.

     This is the previous icon, stretched wider at the owner's ask: the battery
     now spans the FULL 24-wide canvas, edge to edge. The old shape was 22.1
     wide, so a full +10% would have clipped the battery terminal off the
     canvas - this is +8.6%, everything the tile can hold. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- The battery, edge to edge, solid - body, rounded shoulders and
         terminal - with the S cut out of the fill (fillType evenOdd). -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M 1.63 6.6 L 20.31 6.6 A 1.63 1.5 0 0 1 21.94 8.1 L 21.94 15.9 A 1.63 1.5 0 0 1 20.31 17.4 L 1.63 17.4 A 1.63 1.5 0 0 1 0 15.9 L 0 8.1 A 1.63 1.5 0 0 1 1.63 6.6 Z M 22.59 10.1 L 23.02 10.1 A 0.98 0.9 0 0 1 24 11 L 24 13 A 0.98 0.9 0 0 1 23.02 13.9 L 22.59 13.9 Z M 6.52 9 L 15.2 9 L 15.2 10.5 L 8.69 10.5 L 8.69 11.8 L 15.2 11.8 L 15.2 16 L 6.52 16 L 6.52 14.5 L 13.03 14.5 L 13.03 13.3 L 6.52 13.3 Z" />
</vector>
