<?xml version="1.0" encoding="utf-8"?>
<!-- The Quick Settings tile icon: a WIDE, FILLED battery with an S, drawn the
     way system tiles are drawn - one flat shape on a transparent 24dp canvas,
     which the system tints by state (white on the coloured circle while the
     mode is on, plain while off, exactly like Wi-Fi and Bluetooth). The S is
     part of the same path, so it is a true cut-out: it shows the tile's own
     colour through the filled battery, which is how it reads as white on the
     active tile. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- The battery, edge to edge, solid - body, rounded shoulders and
         terminal - with the S cut out of the fill (fillType evenOdd). -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="
            M3.0,6.6 L20.2,6.6 A1.5,1.5 0 0 1 21.7,8.1 L21.7,15.9 A1.5,1.5 0 0 1 20.2,17.4 L3.0,17.4 A1.5,1.5 0 0 1 1.5,15.9 L1.5,8.1 A1.5,1.5 0 0 1 3.0,6.6 Z
            M22.3,10.1 L22.7,10.1 A0.9,0.9 0 0 1 23.6,11.0 L23.6,13.0 A0.9,0.9 0 0 1 22.7,13.9 L22.3,13.9 Z
            M7.5,9.0 L15.5,9.0 L15.5,10.5 L9.5,10.5 L9.5,11.8 L15.5,11.8 L15.5,16.0 L7.5,16.0 L7.5,14.5 L13.5,14.5 L13.5,13.3 L7.5,13.3 Z" />
</vector>
