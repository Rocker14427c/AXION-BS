<?xml version="1.0" encoding="utf-8"?>
<!-- The Quick Settings tile icon: a landscape battery with an S, drawn the way
     system tiles are - one flat white-on-transparent shape at 24dp. The system
     itself tints a tile's icon and background by state, so this is what makes
     the tile colour while the mode is on and go plain when it is off, exactly
     like Wi-Fi and Bluetooth. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- The battery body: an outline (outer rect minus inner rect), landscape. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M4.6,7.5 L18.4,7.5 A1.9,1.9 0 0 1 20.3,9.4 L20.3,14.6 A1.9,1.9 0 0 1 18.4,16.5 L4.6,16.5 A1.9,1.9 0 0 1 2.7,14.6 L2.7,9.4 A1.9,1.9 0 0 1 4.6,7.5 Z M4.7,9.4 L4.7,14.6 L18.4,14.6 L18.4,9.4 Z" />

    <!-- The terminal on the right. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M21.2,10.1 L21.6,10.1 A0.95,0.95 0 0 1 22.55,11.05 L22.55,12.95 A0.95,0.95 0 0 1 21.6,13.9 L21.2,13.9 Z" />

    <!-- The S, stroked so it reads at a glance. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.15"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M14.5,10.6 C13.4,9.9 9.6,10.0 9.6,11.1 C9.6,12.2 14.4,12.0 14.4,13.1 C14.4,14.2 10.6,14.3 9.5,13.6" />
</vector>
